{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/post-write.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-build.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "example-skills@anthropic-agent-skills": false,
    "pr-review-toolkit@claude-plugins-official": false,
    "mcp-server-dev@claude-plugins-official": false,
    "agent-sdk-dev@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false,
    "session-report@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": false
  },
  "model": "claude-sonnet-4-6"
}
