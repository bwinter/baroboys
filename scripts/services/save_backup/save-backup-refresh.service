[Unit]
Description=Save Backup Service Refresh
Requires=network-online.target refresh-repo-startup.service infrastructure-refresh.service
After=network-online.target refresh-repo-startup.service infrastructure-refresh.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/bwinter_sc81
User=bwinter_sc81
ExecStart=/home/bwinter_sc81/baroboys/scripts/services/save_backup/refresh.sh
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
